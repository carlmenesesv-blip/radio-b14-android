{
  "name": "radio-b14-windows",
  "productName": "AURA",
  "version": "1.0.0",
  "description": "AURA para Windows: pantalla táctil del radio + pantalla del cluster + ESP32 por USB",
  "main": "main.js",
  "private": true,
  "author": "AURA",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cr.radiob14.windows",
    "productName": "AURA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "homebtn.html",
      "homebtn-preload.js",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "www",
        "to": "www"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}